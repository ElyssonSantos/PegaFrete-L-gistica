# =========================================================================
# PegaFrete Admin Portal — Variáveis de Ambiente
# =========================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA faça commit do .env no controle de versão.
# =========================================================================

# Porta do servidor Express
PORT=5000

# Chave secreta para promoção do primeiro administrador.
# Gere uma string aleatória forte. Exemplo: openssl rand -hex 32
ADMIN_SETUP_SECRET=troque_por_uma_chave_forte_e_aleatoria

# Credenciais do Firebase Admin SDK (Service Account)
# Pode ser o caminho do arquivo JSON ou o conteúdo JSON em string.
# Para obter: Firebase Console → Configurações → Contas de Serviço → Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_JSON=caminho/para/serviceAccountKey.json
