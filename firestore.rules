rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções Auxiliares de Segurança
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      // IDOR FIX: Apenas o dono ou Admin pode ler o próprio perfil
      allow read: if isOwner(userId) || isAdmin();

      // Criação de perfil: Dono ou Admin.
      // Usuários comuns podem se cadastrar apenas como 'driver' ou 'shipper' e com status inicial 'Pendente' ou 'Documentação Incompleta'.
      // É estritamente proibido criar perfis com privilégio 'admin', docStatus 'Aprovado', documentStatus 'verified' ou documentStatuses.
      allow create: if isAdmin()
                    || (isOwner(userId)
                        && ('role' in request.resource.data && request.resource.data.role in ['driver', 'shipper'])
                        && !('admin' in request.resource.data && request.resource.data.admin == true)
                        && (!('docStatus' in request.resource.data) || request.resource.data.docStatus in ['Pendente', 'Documentação Incompleta'])
                        && !('documentStatus' in request.resource.data)
                        && !('documentStatuses' in request.resource.data));

      // Atualização de perfil: Dono ou Admin.
      // Usuários comuns não podem alterar 'role', adicionar flag 'admin', alterar 'docStatus'/'documentStatus' para estados aprovados/verificados,
      // nem inserir estados de aprovação no mapa 'documentStatuses'.
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || request.resource.data.role == resource.data.role)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['docStatus']) 
                            || request.resource.data.docStatus in ['Pendente', 'Documentação Incompleta', 'Em Análise'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['documentStatus']) 
                            || request.resource.data.documentStatus == 'pending')
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['documentStatuses']) 
                            || (request.resource.data.docStatus in ['Pendente', 'Documentação Incompleta', 'Em Análise']
                                && !request.resource.data.documentStatuses.values().hasAny(['Aprovado', 'verified', 'Reprovado', 'Bloqueado']))));

      allow delete: if isAdmin();
      
      // Isolamento de Dados: Subcoleção pública opcional para dados não-sensíveis
      match /public/{docId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    match /fcm_tokens/{tokenId} {
      // Tokens de notificação são restritos
      // tokenId == userId, garantindo que o próprio usuário insere seu token
      allow read: if isAdmin();
      allow create, update: if isOwner(tokenId) || isAdmin();
      allow delete: if isOwner(tokenId) || isAdmin();
    }

    match /freights/{freightId} {
      // Leitura para usuários autenticados
      allow read: if isAuthenticated();
      
      // Validação do criador da carga (deve estar autenticado e ser o dono)
      allow create: if isAuthenticated() && request.resource.data.shipperUid == request.auth.uid;
                    
      // Zero Trust: Impede alterações fraudulentas do status de pagamento pelo front
      // Middleware de Acesso: Apenas motoristas com docStatus 'Aprovado' podem aceitar fretes
      allow update: if (isAuthenticated() && resource.data.shipperUid == request.auth.uid 
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status_pagamento', 'pagamento_liberado', 'canhoto_id']))
                    || isAdmin()
                    || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver' 
                        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.docStatus == 'Aprovado'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'driverUid']));
                    
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.shipperUid == request.auth.uid);
    }

    match /public_emails/{email} {
      // Leitura aberta para verificar disponibilidade no cadastro
      allow read: if true;
      // Criação e atualização restritas ao próprio e-mail autenticado
      allow create, update: if isAuthenticated()
                            && request.auth.token.email != null
                            && request.auth.token.email.lower() == email.lower();
      // Exclusão SOMENTE pelo backend (Admin SDK)
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_messages/{messageId} {
      allow read: if isAuthenticated() && resource.data.userUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userUid == request.auth.uid && request.resource.data.userUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /security_logs/{logId} {
      // Logs são append-only e gravados com a identidade confirmada do usuário
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false; 
    }

    match /transactions/{transactionId} {
      // Carteira Digital: TUDO BLOQUEADO no front-end para gravação. 
      // 100% gerenciado via Cloud Functions atômicas (Transactions) contra Race Conditions.
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if false; 
    }

    match /canhotos/{canhotoId} {
      // Baixa de Canhoto: Upload deve acionar uma Cloud Function. 
      // Leitura apenas pelas partes envolvidas.
      allow read: if isAuthenticated();
      allow write: if false; // Manipulação exclusiva via Cloud Functions
    }
  }
}
