rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // IDOR Prevention: Documentos sensíveis isolados em /documents/{userId}/...
    match /documents/{userId}/{fileName} {
      // Apenas o dono ou admin pode acessar seus documentos
      allow read: if isOwner(userId) || isAdmin();
      
      // Validação estrita de tipo de arquivo e limite de tamanho
      allow create, update: if isOwner(userId)
                   && request.resource.size < 10 * 1024 * 1024 // Limite 10MB
                   && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
                   
      allow delete: if isAdmin();
    }

    // Proteção de Baixa de Canhotos
    match /canhotos/{freightId}/{fileName} {
      // Leitura permitida para autenticados (Ideal seria restrito às partes, mas sem cross-rules mantemos a base atual)
      allow read: if isAuthenticated();
      
      // Apenas inserção. Bloqueamos update para evitar que motoristas falsifiquem/substituam canhotos de terceiros
      allow create: if isAuthenticated() 
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
                   
      allow update, delete: if isAdmin();
    }

    // Fotos de perfil
    match /profiles/{userId}/{fileName} {
      allow read: if isAuthenticated();
      
      allow create, update: if isOwner(userId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
                   
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
