rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // IDOR Prevention: Documentos sensíveis isolados em /documents/{userId}/...
    match /documents/{userId}/{fileName} {
      // Apenas o dono ou admin pode acessar seus documentos
      allow read: if isOwner(userId) || isAdmin();
      
      // Validação restrita de tipo de arquivo e limite de tamanho
      allow write: if isOwner(userId)
                   && request.resource.size < 10 * 1024 * 1024 // Limite 10MB
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Proteção de Baixa de Canhotos
    match /canhotos/{freightId}/{fileName} {
      // Somente admin/cloud functions alteram status, motoristas podem enviar canhoto
      // Implementar segurança adicional no backend (Function dispara no onFinalize)
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() 
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Fotos de perfil
    match /profiles/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
